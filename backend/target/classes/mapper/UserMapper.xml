<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gov.security.mapper.UserMapper">

    <resultMap id="UserPageVOResultMap" type="com.gov.security.controller.dto.UserPageVO">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="realName" column="real_name"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="deptName" column="dept_name"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 动态 WHERE 条件（用于分页查询与计数） -->
    <sql id="userWhereClause">
        <where>
            <if test="username != null and username != ''">
                AND u.username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="status != null">
                AND u.status = #{status}
            </if>
            <if test="role != null and role != ''">
                AND EXISTS (
                    SELECT 1 FROM user_role ur2
                    INNER JOIN role r2 ON ur2.role_id = r2.id
                    WHERE ur2.user_id = u.id AND r2.role_code = #{role}
                )
            </if>
        </where>
    </sql>

    <!-- 分页查询用户列表（含部门名称）
         使用延迟关联（deferred join）优化大数据量分页性能：
         先在子查询中按条件筛选并分页取 id，再 JOIN 获取完整字段，避免回表扫描全量数据 -->
    <select id="findPage" resultMap="UserPageVOResultMap">
        SELECT u.id, u.username, u.real_name, u.phone, u.status, u.create_time,
               d.dept_name
        FROM (
            SELECT id FROM user u
            <include refid="userWhereClause"/>
            ORDER BY create_time DESC
            LIMIT #{size} OFFSET #{offset}
        ) t
        INNER JOIN user u ON u.id = t.id
        LEFT JOIN dept d ON u.dept_id = d.id
        ORDER BY u.create_time DESC
    </select>

    <!-- 统计总数 -->
    <select id="countPage" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM user u
        <include refid="userWhereClause"/>
    </select>

    <!-- 批量插入用户角色关联 -->
    <insert id="insertUserRoles">
        INSERT INTO user_role(user_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

</mapper>
